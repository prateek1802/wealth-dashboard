+    expect(second.toInsert).toHaveLength(0);
+    expect(second.alreadyImported).toBe(TOTAL_REAL_TRANSACTIONS);
+  });
+
+  it("a partial-overlap re-import (E already persisted) only proposes C/G's rows as new", () => {
